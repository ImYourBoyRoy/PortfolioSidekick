# Portfolio Sidekick Environment Configuration Template
# Copy this file to .env and fill in your details.
# DO NOT commit the .env file to public version control.

# --- Backend Options ---
# Binding address for Uvicorn server (127.0.0.1 for high local security, 0.0.0.0 for LAN/mobile connections)
HOST=127.0.0.1
PORT=8000

# Robinhood Sandbox configuration (enter "sandbox" to run offline simulations without connecting real accounts)
RH_USERNAME=sandbox
RH_PASSWORD=

# --- Compilation & DevOps Options ---
# Optional: GitHub Personal Access Token (PAT) for release compilation and automatic uploads
GITHUB_TOKEN=
