# Portfolio Sidekick Environment Configuration Template
# Copy this file to .env and fill in your details.
# DO NOT commit the .env file to public version control.

# --- Backend Options (development mode only) ---
# Production desktop builds use IPC only — no HTTP listener.
# Dev mode binds loopback only for Vite hot-reload workflows.
HOST=127.0.0.1
PORT=8000

# Robinhood Sandbox configuration (enter "sandbox" to run offline simulations)
RH_USERNAME=sandbox
RH_PASSWORD=

# --- Compilation & DevOps Options ---
GITHUB_TOKEN=
