{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal secure permissions for Portfolio Sidekick desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-auth-log-append",
    "allow-portable-data-path",
    "allow-portable-write-file",
    "allow-portable-read-file",
    "allow-portable-file-exists",
    "allow-rh-desktop-ready",
    "allow-rh-robinhood-login",
    "allow-rh-http-request",
    "allow-vault-read",
    "allow-vault-write",
    "allow-ps-apply-portable-update",
    "fs:allow-exe-read-recursive",
    "fs:allow-exe-write-recursive",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.robinhood.com/**" },
        { "url": "https://query1.finance.yahoo.com/**" },
        { "url": "https://query2.finance.yahoo.com/**" },
        { "url": "https://api.github.com/**" },
        { "url": "https://github.com/**" },
        { "url": "https://objects.githubusercontent.com/**" }
      ]
    }
  ]
}
