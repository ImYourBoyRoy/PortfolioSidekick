#!/bin/sh
# ./.githooks/prepare-commit-msg
# Strip Cursor agent co-author trailers from commit messages.
COMMIT_MSG_FILE=$1
if [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi
TMP_FILE="${COMMIT_MSG_FILE}.cursor-strip"
grep -v '^Co-authored-by: Cursor <cursoragent@cursor.com>$' "$COMMIT_MSG_FILE" > "$TMP_FILE" || cp "$COMMIT_MSG_FILE" "$TMP_FILE"
mv "$TMP_FILE" "$COMMIT_MSG_FILE"
